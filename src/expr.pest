WHITESPACE = _{ " " | "\t" | NEWLINE }
// Deliberately narrower than pest's builtin NEWLINE, which also accepts a lone
// "\r": pest counts lines by "\n" and "\r\n" only, so accepting a lone "\r" would
// mean the line and column reported in an error disagreed with the line the
// parser thinks it is on. This definition shadows the builtin -- removing it does
// not fall back to something equivalent.
NEWLINE     = _{ "\r\n" | "\n" }
COMMENT     = _{ "//" ~ (!NEWLINE ~ ANY)* }

program        = { SOI ~ expr ~ EOI }
delimited_expr = { SOI ~ expr ~ "}" }

// Expressions and precedence (operators are recognized by Pratt in Rust)
expr        = { unary ~ ( (op_or | op_and | op_eq | op_cmp | op_add | op_mul | op_pow) ~ unary )* }

unary       = { unary_op* ~ postfix }
unary_op    = { not_op | neg_op }
not_op      = @{ "!" }
neg_op      = @{ "-" }

postfix     = { primary ~ (call | index | property)* }

call        = { "(" ~ (expr ~ ("," ~ expr)*)? ~ ")" }
index       = { "[" ~ expr ~ "]" }
property    = { "." ~ ident }

primary     = { number | boolean | string | list | dict | ident | parens }
parens      = { "(" ~ expr ~ ")" }

// Literals
number      = { float | int }
int         = @{ ASCII_DIGIT+ }
float       = @{
    (ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ exponent?)  // 1.23  1.23e+4
  | ("." ~ ASCII_DIGIT+ ~ exponent?)                  // .5    .5e2
  | (ASCII_DIGIT+ ~ exponent)                          // 1e10
}
exponent    = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }

// A keyword is only a keyword as a whole word. `primary` tries `boolean` before
// `ident`, so without the trailing lookahead "trueish" would match the literal
// `true` and then leave "ish" for a parser that has nowhere to put it. pest has
// no word-boundary builtin, so the boundary is spelled as "not continuable as an
// identifier" -- which is what it actually means, and is why it is `ident_cont`
// and not a private copy of the same character class.
boolean     = { true_kw | false_kw }
true_kw     = @{ "true" ~ !ident_cont }
false_kw    = @{ "false" ~ !ident_cont }

string        = { PUSH( "\"" | "'" ) ~ string_char* ~ POP }
string_char   = @{ quoted_escape | (!(PEEK | NEWLINE) ~ ANY) }
quoted_escape = @{ "\\n" | "\\\\" | "\\" ~ PEEK }

// Collections
list        = { "[" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "]" }

pair        = { expr ~ ":" ~ expr }
dict        = { "{" ~ (pair ~ ("," ~ pair)* ~ ","?)? ~ "}" }

// Operators (atomic to avoid accidental spaces inside)
op_or       = @{ "||" }
op_and      = @{ "&&" }
op_add      = @{ "+" | "-" }
op_mul      = @{ "*" | "/" | "%" }
op_pow      = @{ "^" }
op_eq       = @{ "==" | "!=" }
op_cmp      = @{ "<=" | ">=" | "<" | ">" }

// Identifiers
// `ident_cont` is the single definition of "character that continues a word": it
// is both what an identifier is made of and what a keyword must not be followed
// by. Widening it (to `XID_CONTINUE`, say) has to move both together, so they
// stay defined here rather than inline at each use.
ident       = @{ ident_start ~ ident_cont* }
ident_start = _{ ASCII_ALPHA | "_" }
ident_cont  = _{ ASCII_ALPHANUMERIC | "_" }